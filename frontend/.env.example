# .env.example — copia este archivo a .env y rellena los valores.
# El .env real está en .gitignore: nunca lo subas al repositorio.
#
# OJO: todo lo que empiece por VITE_ se compila dentro del bundle y queda
# visible para cualquiera que abra el navegador. Aquí solo van claves
# públicas; los secretos van en el .env del backend.

# URL del backend. En local: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Claves de Google. Restríngelas por referente HTTP en Google Cloud
# (localhost y tu dominio), porque quedan expuestas en el navegador.
VITE_GEMINI_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Llave PÚBLICA de Wompi (pub_test_… o pub_prod_…).
# El secreto de integridad NO va aquí: la firma se calcula en el backend.
VITE_WOMPI_PUBLIC_KEY=
