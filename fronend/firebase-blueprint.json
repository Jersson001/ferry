{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Información del perfil de usuario, contratista o tienda",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "ID único de Firebase Auth" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["USER", "STORE", "ADMIN"] },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "Documento de perfil de cada usuario"
    }
  }
}
