# .env.example — copia este archivo a .env y rellena los valores.
# El .env real está en .gitignore: nunca lo subas al repositorio.

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria por entorno.
JWT_SECRET=

# API key de Gemini (https://aistudio.google.com/apikey). Empieza por "AIza".
GEMINI_API_KEY=

# SMTP para los correos de verificación y recuperación de contraseña.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
# Con Gmail, una contraseña de aplicación, no la del correo.
MAIL_PASSWORD=
MAIL_FROM=Ferry <tu-correo@ejemplo.com>

# Base de la URL del frontend: arma los enlaces de los correos.
# En local: http://localhost:5173 — en producción, la URL pública.
FRONTEND_URL=http://localhost:5173

# Base de datos. Si se omiten, el backend usa estos mismos valores por defecto
# (los del docker-compose.yml).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=ferry_db

# Opcionales: puerto del backend y ruta de los archivos subidos.
PORT=3000
UPLOADS_PATH=
