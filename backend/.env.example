# .env.example — copia este archivo a .env y rellena los valores.
# El .env real está en .gitignore: nunca lo subas al repositorio.

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria por entorno.
JWT_SECRET=

# API key de Gemini (https://aistudio.google.com/apikey).
# Debe salir del mismo proyecto de Google Cloud que la clave de Maps.
GEMINI_API_KEY=

# Correos de verificación y recuperación, por la API de Resend.
# No se usa SMTP: Render bloquea los puertos SMTP salientes.
# La clave se crea en https://resend.com/api-keys y empieza por "re_".
RESEND_API_KEY=
# El remitente debe pertenecer a un dominio verificado en Resend.
# Ojo: el verificado aquí es el subdominio mail.ferryapp.co, no el raíz.
MAIL_FROM=Ferry <no-reply@mail.ferryapp.co>

# Base de la URL del frontend: arma los enlaces de los correos.
# En local: http://localhost:5173 — en producción, la URL pública.
FRONTEND_URL=http://localhost:5173

# Base de datos.
#
# En producción (Supabase, Neon, Render) se usa una sola URL. Si DATABASE_URL
# está definida, tiene prioridad y la conexión se hace con TLS:
#   DATABASE_URL=postgresql://postgres.proyecto:clave@host.pooler.supabase.com:5432/postgres
# En Supabase, tomar el connection string del **Session pooler**. El
# transaction pooler (6543) es para serverless y no soporta prepared
# statements.
DATABASE_URL=

# En local, con el Postgres del docker-compose, se dejan los campos sueltos
# y DATABASE_URL vacía. Estos son además los valores por defecto.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=ferry_db

# Fotos y videos que suben los usuarios, en Supabase Storage.
# Si SUPABASE_URL y SUPABASE_SECRET_KEY están, los archivos van a Supabase;
# si no, al disco local (uploads/). En producción son obligatorias: el disco
# de Render se borra en cada despliegue.
#   SUPABASE_URL: Project Settings → Data API → Project URL
#   SUPABASE_SECRET_KEY: Project Settings → API Keys → Secret key (sb_secret_…)
# El bucket se crea solo, como público, la primera vez que se sube algo.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Opcionales: puerto del backend y ruta de los archivos en disco local.
PORT=3000
UPLOADS_PATH=
